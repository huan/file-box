{
  "name": "file-box",
  "version": "2.0.0",
  "description": "Pack a File into Box for easy move/transfer between servers no matter of where it is.(local path, remote url, or cloud storage)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/src/mod.d.ts",
      "import": "./dist/esm/src/mod.js"
    }
  },
  "types": "./dist/esm/src/mod.d.ts",
  "engines": {
    "node": ">=26",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc",
    "clean": "shx rm -fr dist/*",
    "dist": "npm run clean && npm run build",
    "lint": "npm run lint:biome && npm run lint:ts",
    "lint:biome": "biome lint src tests",
    "lint:ts": "tsc --isolatedModules --noEmit",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "node --test src tests",
    "test:unit:browser": "wtr --config web-test-runner.config.js",
    "test:pack": "bash -x scripts/npm-pack-testing.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huan/file-box.git"
  },
  "keywords": [
    "file",
    "virtual",
    "cloud",
    "url",
    "stream",
    "http",
    "api"
  ],
  "author": "Huan LI <zixia@zixia.net>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/huan/file-box/issues"
  },
  "homepage": "https://github.com/huan/file-box#readme",
  "dependencies": {
    "brolog": "^1.14.2",
    "clone-class": "^1.0.3",
    "jpeg-js": "^0.4.4",
    "mime": "^3.0.0",
    "qr": "^0.7.2",
    "qrcode": "^1.5.4",
    "upng-js": "^2.1.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@types/chai": "^5.2.3",
    "@types/mime": "^3.0.0",
    "@types/node": "^26.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/sinon": "^17.0.3",
    "@types/upng-js": "^2.1.2",
    "@types/uuid": "^8.3.4",
    "@web/dev-server-esbuild": "^2.0.1",
    "@web/dev-server-rollup": "^0.6.1",
    "@web/test-runner": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.2",
    "chai": "^6.3.0",
    "node-stdlib-browser": "^1.3.1",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "shx": "^0.3.4",
    "sinon": "^19.0.2",
    "typescript": "^5.8.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
