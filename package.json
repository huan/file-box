{
  "name": "file-box",
  "version": "2.2.0",
  "description": "Pack a File into Box for easy move/transfer between servers no matter of where it is.(local path, remote url, or cloud storage)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/src/mod.d.ts",
      "import": "./dist/esm/src/mod.js"
    },
    "./browser": {
      "types": "./dist/esm/src/mod.d.ts",
      "import": "./dist/esm/src/mod.js"
    },
    "./server": {
      "types": "./dist/esm/src/server/mod.d.ts",
      "import": "./dist/esm/src/server/mod.js"
    }
  },
  "types": "./dist/esm/src/mod.d.ts",
  "engines": {
    "node": ">=26",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc",
    "clean": "shx rm -fr dist/*",
    "dist": "npm run clean && npm run build",
    "lint": "npm run lint:biome && npm run lint:ts",
    "lint:biome": "biome lint src tests",
    "lint:ts": "tsc --isolatedModules --noEmit",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "node --test --experimental-test-coverage src tests/file-box-smoke.native.test.ts tests/resolution-matrix.native.test.ts tests/integration.test.ts",
    "test:unit:deno": "deno test --no-check --node-modules-dir=manual --allow-read=.,/tmp --allow-write=/tmp --allow-env --allow-net=127.0.0.1 --allow-run=node --allow-sys=homedir,hostname src tests/file-box-smoke.native.test.ts tests/resolution-matrix.native.test.ts tests/integration.test.ts",
    "test:unit:browser": "wtr --config web-test-runner.config.js",
    "test:browser": "npm run test:unit:browser",
    "test:pack": "bash -x scripts/npm-pack-testing.sh",
    "coverage": "npm run coverage:unit && npm run coverage:browser",
    "coverage:unit": "node --test --experimental-test-coverage src tests/file-box-smoke.native.test.ts tests/resolution-matrix.native.test.ts tests/integration.test.ts",
    "coverage:browser": "wtr --config web-test-runner.config.js --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huan/file-box.git"
  },
  "keywords": [
    "file",
    "virtual",
    "cloud",
    "url",
    "stream",
    "http",
    "api"
  ],
  "author": "Huan LI <zixia@zixia.net>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/huan/file-box/issues"
  },
  "homepage": "https://github.com/huan/file-box#readme",
  "dependencies": {
    "brolog": "^2.0.0",
    "clone-class": "^1.1.1",
    "image-in-browser": "^3.8.0",
    "mime": "^4.1.2",
    "qr": "^0.7.2",
    "tiff": "^7.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/chai": "^5.2.3",
    "@types/node": "^26.0.0",
    "@web/dev-server-esbuild": "^2.0.1",
    "@web/test-runner": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.2",
    "chai": "^6.3.0",
    "esbuild": "^0.28.2",
    "shx": "^0.3.4",
    "typescript": "^5.8.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
